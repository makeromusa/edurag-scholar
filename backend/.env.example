# ==============================================================================
# EduRAG Scholar: Environment Configuration Template
# Duplicate this file to .env and populate your active credentials.
# ==============================================================================

# Server & Runtime
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","https://*.vercel.app"]

# Supabase (Auth, PostgreSQL DB, pgvector, Storage)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET_NAME=course-materials

# Azure OpenAI (Student Pack Credits)
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Alternative / Fallback Direct OpenAI (if using direct API)
# OPENAI_API_KEY=sk-...

# Agentic Web Fallback (Tavily Search API)
TAVILY_API_KEY=tvly-your-tavily-api-key

# The 3 AM Nightly Abstractor (SendGrid Email)
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDGRID_FROM_EMAIL=scholar@edurag.internal
STUDENT_ALERT_EMAIL=asmanmakero@gmail.com
ABSTRACT_CRON_HOUR=3
ABSTRACT_CRON_MINUTE=0
TIMEZONE=Africa/Nairobi

# Observability (Sentry)
SENTRY_DSN=
